---
permalink: /index.html
eleventyExcludeFromCollections: true
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ site.domain }}</title>
  <meta name="robots" content="noindex, nofollow">
  <!-- No JS: default to English -->
  <meta http-equiv="refresh" content="0;url=/en/">
  <script>
    (function () {
      function redirect(url) {
        try { location.replace(url); } catch (e) {}
      }
      function pickLanguage() {
        var saved = null;
        try { saved = localStorage.getItem('zyatnin-lang'); } catch (e) {}
        if (saved === 'ru' || saved === 'en' || saved === 'he') return saved;
        var list = navigator.languages || [navigator.language || 'en'];
        for (var i = 0; i < list.length; i++) {
          var code = String(list[i]).toLowerCase().split('-')[0];
          if (code === 'ru' || code === 'he') return code;
        }
        return 'en';
      }
      function pickView() {
        try { return localStorage.getItem('zyatnin-view') === 'dev' ? 'dev/' : ''; } catch (e) { return ''; }
      }
      redirect('/' + pickLanguage() + '/' + pickView());
    })();
  </script>
</head>
<body>
  <p>
    <a href="/ru/">Русский</a> ·
    <a href="/en/">English</a> ·
    <a href="/he/">עברית</a>
  </p>
  <p>
    <a href="/ru/dev/">Русский — разработчик</a> ·
    <a href="/en/dev/">English — developer</a> ·
    <a href="/he/dev/">עברית — מפתח</a>
  </p>
</body>
</html>