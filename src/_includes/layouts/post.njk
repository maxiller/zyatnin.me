---
layout: layouts/base.njk
---

<article class="article">
  <div class="container container--narrow">
    <a href="/{{ i18n.lang }}/blog/" class="article__back">{{ i18n.blog.back }}</a>
    <div class="article__header">
      <span class="article__topic">{{ i18n.topics[topic] }}</span>
      <h1 class="article__title">{{ title }}</h1>
      <span class="article__meta">{{ date | dateDisplay(i18n.lang) }} · {{ content | readingTime }} {{ i18n.blog.min_read }}</span>
    </div>
    {% set ldPublished = date | isoDateTime %}
    {% set ldModified = updated | default(date) | isoDateTime %}
    {% set ld = {
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": title,
      "description": description | default(excerpt),
      "datePublished": ldPublished,
      "dateModified": ldModified,
      "inLanguage": i18n.lang,
      "author": { "@type": "Person", "name": i18n.name, "url": "https://" + site.domain + "/" + i18n.lang + "/" },
      "mainEntityOfPage": { "@type": "WebPage", "@id": "https://" + site.domain + page.url }
    } %}
    <script type="application/ld+json">{{ ld | toJson | safe }}</script>
    <div class="article__body">
      {{ content | safe }}
    </div>
  </div>
</article>
