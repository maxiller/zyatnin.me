---
layout: layouts/base.njk
---

<div class="page-header">
  <div class="container container--narrow">
    <h1 class="page-header__title">{{ i18n.blog.title }}</h1>
    <p class="page-header__desc">{{ i18n.blog.subtitle }}</p>
  </div>
</div>

<div class="blog-page">
  <div class="container">
    {#- Один список в порядке убывания даты: коллекция posts_<lang> уже
        отсортирована (AR-05), поэтому группировка по топикам не нужна. -#}
    {% set allPosts = collections["posts_" + i18n.lang] | byView("leader") %}

    {% if allPosts | length == 0 %}
    <p class="blog-page__empty">{{ i18n.blog.empty }}</p>
    {% else %}
    <div class="blog-grid">
      {% for post in allPosts %}
      <a href="{{ post.url }}" class="blog-card fade-in">
        <span class="blog-card__topic">{{ i18n.topics[post.data.topic] }}</span>
        <h3 class="blog-card__title">{{ post.data.title }}</h3>
        <p class="blog-card__excerpt">{{ post.data.excerpt }}</p>
        <div class="blog-card__meta">
          <span>{{ post.data.date | dateWeek }}</span>
          <span class="blog-card__read">{{ i18n.blog.read_more }}</span>
        </div>
      </a>
      {% endfor %}
    </div>
    {% endif %}
  </div>
</div>
