---
layout: layouts/base.njk
---

<div class="page-header">
  <div class="container container--narrow">
    <h1 class="page-header__title">{{ i18n.leader.blog.title }}</h1>
    <p class="page-header__desc">{{ i18n.leader.blog.subtitle }}</p>
  </div>
</div>

<div class="blog-page">
  <div class="container">
    {#- Один список в порядке убывания даты: коллекция posts_<lang> уже
        отсортирована (AR-05), поэтому группировка по топикам не нужна. -#}
    {% set allPosts = collections["posts_" + i18n.lang] | byView("leader") %}

    {% if allPosts | length == 0 %}
    <p class="blog-page__empty">{{ i18n.blog.empty }}</p>
    {% else %}
    {% set tagPages = collections["tagPages_" + i18n.lang + "_leader"] %}
    {% include "partials/tag-bar.njk" %}
    {% set posts = allPosts %}
    {% include "partials/post-list.njk" %}
    {% endif %}
  </div>
</div>
