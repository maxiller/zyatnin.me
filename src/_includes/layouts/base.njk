<!DOCTYPE html>
<html lang="{{ i18n.lang }}" dir="{{ i18n.dir }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if title %}{{ title }} — {{ i18n.name }}{% else %}{{ i18n.name }} — {{ i18n.hero.title }}{% endif %}</title>
  <meta name="description" content="{% if description %}{{ description }}{% elif excerpt %}{{ excerpt }}{% else %}{{ i18n.hero.desc }}{% endif %}">
  <meta property="og:title" content="{% if title %}{{ title }} — {{ i18n.name }}{% else %}{{ i18n.name }} — {{ i18n.hero.title }}{% endif %}">
  <meta property="og:description" content="{% if description %}{{ description }}{% elif excerpt %}{{ excerpt }}{% else %}{{ i18n.hero.desc }}{% endif %}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://{{ site.domain }}{{ page.url }}">
  <meta property="og:locale" content="{% if i18n.lang == 'ru' %}ru_RU{% elif i18n.lang == 'he' %}he_IL{% else %}en_US{% endif %}">
  <meta name="color-scheme" content="light">
  <meta name="theme-color" content="#f7f8fa">
  <meta property="og:image" content="https://{{ site.domain }}/assets/og-image.png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="{{ i18n.name }} — {{ site.domain }}">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="canonical" href="https://{{ site.domain }}{{ page.url }}">
  <link rel="alternate" hreflang="ru" href="https://{{ site.domain }}{{ page.url | replace('/en/', '/ru/') | replace('/he/', '/ru/') }}">
  <link rel="alternate" hreflang="en" href="https://{{ site.domain }}{{ page.url | replace('/ru/', '/en/') | replace('/he/', '/en/') }}">
  <link rel="alternate" hreflang="he" href="https://{{ site.domain }}{{ page.url | replace('/ru/', '/he/') | replace('/en/', '/he/') }}">
  <link rel="alternate" hreflang="x-default" href="https://{{ site.domain }}{{ page.url | replace('/ru/', '/en/') | replace('/he/', '/en/') }}">
  <link rel="alternate" type="application/atom+xml" href="/{{ i18n.lang }}/feed.xml" title="{{ i18n.name }} — {{ i18n.views.leader }}">
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='6' fill='%231a1b2e'/><text x='4' y='23' font-family='monospace' font-size='18' font-weight='bold' fill='%230ea5e9'>MZ</text></svg>">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/assets/style.css">
  <script>document.documentElement.classList.add('js');</script>
</head>
<body>
  <a href="#main" class="skip-link">{{ i18n.skip_link }}</a>

  <header class="site-header">
    <div class="container site-header__inner">
      <a href="/{{ i18n.lang }}/" class="brand">
        <svg class="brand__mark" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <rect width="32" height="32" rx="7" fill="currentColor" opacity="0.1"/>
          <path d="M5 22V10l5.5 7L16 10v12M18 10h9l-9 12h9" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span class="brand__name">{{ site.domain }}</span>
      </a>

      <nav class="site-nav" aria-label="{{ i18n.a11y.navigation }}">
        <a href="/{{ i18n.lang }}/#about">{{ i18n.nav.about }}</a>
        <a href="/{{ i18n.lang }}/#projects">{{ i18n.nav.projects }}</a>
        <a href="/{{ i18n.lang }}/blog/" class="{% if 'blog' in page.url %}active{% endif %}">{{ i18n.nav.blog }}</a>
      </nav>

      <div class="site-header__controls">
        <nav class="view-switch" aria-label="{{ i18n.views.aria_switch }}">
          <span class="view-switch__item active" aria-current="page">{{ i18n.views.leader }}</span>
          <a href="{{ collections.all | switchViewUrl(page.url, i18n.lang, 'dev') }}" data-view="dev" title="{{ i18n.views.leader_full }} → {{ i18n.views.dev }}" aria-label="{{ i18n.views.aria_to_dev }}">{{ i18n.views.dev }}</a>
        </nav>
        <div class="lang-switch">
          <a href="{{ page.url | replace('/en/', '/ru/') | replace('/he/', '/ru/') }}" class="{% if i18n.lang == 'ru' %}active{% endif %}" hreflang="ru">RU</a>
          <a href="{{ page.url | replace('/ru/', '/en/') | replace('/he/', '/en/') }}" class="{% if i18n.lang == 'en' %}active{% endif %}" hreflang="en">EN</a>
          <a href="{{ page.url | replace('/ru/', '/he/') | replace('/en/', '/he/') }}" class="{% if i18n.lang == 'he' %}active{% endif %}" hreflang="he">HE</a>
        </div>
        <button class="menu-toggle" type="button" data-menu-toggle aria-controls="mobile-menu" aria-expanded="false" aria-label="{{ i18n.a11y.menu_open }}" data-label-open="{{ i18n.a11y.menu_open }}" data-label-close="{{ i18n.a11y.menu_close }}">
          <svg class="icon-menu" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
          <svg class="icon-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="5" y1="5" x2="19" y2="19"/><line x1="19" y1="5" x2="5" y2="19"/></svg>
        </button>
      </div>
    </div>

    <nav class="mobile-menu" id="mobile-menu" data-menu-panel aria-label="{{ i18n.a11y.navigation }}">
      <a href="/{{ i18n.lang }}/#about">{{ i18n.nav.about }}</a>
      <a href="/{{ i18n.lang }}/#projects">{{ i18n.nav.projects }}</a>
      <a href="/{{ i18n.lang }}/blog/" class="{% if 'blog' in page.url %}active{% endif %}">{{ i18n.nav.blog }}</a>
    </nav>
  </header>

  <main id="main">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="container">
      <div class="site-footer__inner">
        <div class="site-footer__brand">
          <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" width="26" height="26">
            <rect width="32" height="32" rx="7" fill="currentColor" opacity="0.1"/>
            <path d="M5 22V10l5.5 7L16 10v12M18 10h9l-9 12h9" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span>{{ i18n.name }} · {{ site.domain }}</span>
        </div>
        <div class="site-footer__links">
          <a href="{{ site.github }}" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg>
            <span>GitHub</span>
          </a>
          <a href="mailto:{{ site.email }}">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 6-10 7L2 6"/></svg>
            <span>{{ site.email }}</span>
          </a>
        </div>
        <p class="site-footer__copy">© {{ site.year }} {{ i18n.name }}. {{ i18n.footer.rights }}.</p>
      </div>
    </div>
  </footer>

  <script src="/assets/app.js"></script>
</body>
</html>
