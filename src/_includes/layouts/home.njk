---
layout: layouts/base.njk
---

{% macro projectIcon(n) %}
<svg class="ticket-card__svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {% if n == 1 %}
  <path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"/>
  {% elif n == 2 %}
  <rect width="14" height="14" x="8" y="8" rx="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
  {% elif n == 3 %}
  <rect width="20" height="14" x="2" y="3" rx="2"/><path d="M8 21h8"/><path d="M12 17v4"/>
  {% elif n == 4 %}
  <rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/><circle cx="12" cy="16" r="1.2"/>
  {% elif n == 5 %}
  <path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/>
  {% elif n == 6 %}
  <path d="M4 20h16"/><path d="M7 20v-6"/><path d="M12 20V9"/><path d="M17 20V4"/>
  {% elif n == 7 %}
  <rect x="6" y="4" width="12" height="16" rx="2"/><rect x="9" y="2" width="6" height="4" rx="1"/><path d="m9 13 2 2 4-4"/>
  {% else %}
  <rect x="4" y="4" width="16" height="16" rx="3"/><path d="m9 12 2 2 4-4"/>
  {% endif %}
</svg>
{% endmacro %}

<!-- Hero: business card -->
<section class="hero">
  <div class="container hero__grid">
    <div class="hero__content">
      <p class="hero__greeting">{{ i18n.hero.greeting }}</p>
      <h1 class="hero__name">{{ site.name }}</h1>
      <p class="hero__role">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="4" y="7" width="16" height="14" rx="2"/>
          <path d="M9 7V5a3 3 0 0 1 6 0v2"/>
          <path d="M9 12h6"/>
        </svg>
        {{ i18n.hero.title }}
      </p>
      <p class="hero__desc">{{ i18n.hero.desc }}</p>
      <div class="hero__cta">
        <a href="#projects" class="btn btn--primary">{{ i18n.hero.cta_projects }}</a>
        <a href="/{{ i18n.lang }}/blog/" class="btn btn--ghost">{{ i18n.hero.cta_blog }}</a>
      </div>
    </div>

    <aside class="hero__facts fade-in" aria-label="{{ i18n.about.label }}">
      <p class="hero-facts__caption">{{ i18n.hero.facts_caption }}</p>
      <dl class="hero-facts">
        {% for f in i18n.hero.facts %}
        <div class="hero-facts__row">
          <dt class="hero-facts__label">{{ f.label }}</dt>
          <dd class="hero-facts__value">{{ f.value }}</dd>
        </div>
        {% endfor %}
      </dl>
    </aside>
  </div>
</section>

<!-- About -->
<section id="about" class="section">
  <div class="container">
    <header class="section-head fade-in">
      <span class="section-head__index mono">[01]</span>
      <div class="section-head__text">
        <p class="section-head__label">{{ i18n.about.label }}</p>
        <h2 class="section-head__title">{{ i18n.about.title }}</h2>
      </div>
      <div class="section-head__rule" aria-hidden="true"></div>
    </header>
    <div class="about__grid">
      <div class="about__bio fade-in">
        <p>{{ i18n.about.bio }}</p>
        <h3 class="about__subtitle">{{ i18n.about.skills_label }}</h3>
        <ul class="tags" role="list">
          <li class="tag">Python</li>
          <li class="tag">Podman</li>
          <li class="tag">RQ/Valkey</li>
          <li class="tag">GitLab CI/CD</li>
          <li class="tag">Telegram API</li>
          <li class="tag">Jira API</li>
          <li class="tag">Fedora Linux</li>
          <li class="tag">KDE Plasma</li>
          <li class="tag">Astra Linux</li>
          <li class="tag">PostgreSQL</li>
        </ul>
      </div>
      <aside class="about__side fade-in">
        <h3 class="about__subtitle">{{ i18n.about.interests_label }}</h3>
        <ul class="interests" role="list">
          {% for item in i18n.about.interests %}
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 5 5 9-10"/></svg>
            {{ item }}
          </li>
          {% endfor %}
        </ul>
      </aside>
    </div>
  </div>
</section>

<!-- Projects as tickets -->
<section id="projects" class="section section--alt">
  <div class="container">
    <header class="section-head fade-in">
      <span class="section-head__index mono">[02]</span>
      <div class="section-head__text">
        <p class="section-head__label">{{ i18n.projects.label }}</p>
        <h2 class="section-head__title">{{ i18n.projects.title }}</h2>
      </div>
      <div class="section-head__rule" aria-hidden="true"></div>
    </header>
    <div class="projects__grid">
      {% set projectsForLang = collections["projects_" + i18n.lang] | byView("leader") %}
      {% for proj in projectsForLang %}
      <a href="{{ proj.url }}" class="ticket-card fade-in">
        <div class="ticket-card__top">
          <span class="ticket-card__num mono">№ {{ '0' if proj.data.order < 10 else '' }}{{ proj.data.order }}</span>
          {% if proj.data.status %}
          <span class="badge badge--{{ proj.data.status }}" title="{{ i18n.projects.status[proj.data.status] }}">{{ i18n.projects.status[proj.data.status] }}</span>
          {% endif %}
        </div>
        <div class="ticket-card__icon">{{ projectIcon(proj.data.order) }}</div>
        <h3 class="ticket-card__name">{{ proj.data.title }}</h3>
        <p class="ticket-card__desc">{{ proj.data.excerpt }}</p>
        {% if proj.data.points %}
        <ul class="ticket-card__points" role="list">
          {% for point in proj.data.points %}
          <li>{{ point }}</li>
          {% endfor %}
        </ul>
        {% endif %}
        <ul class="tags tags--small" role="list">
          {% for tag in proj.data.tags %}
          <li class="tag tag--small">{{ tag }}</li>
          {% endfor %}
        </ul>
        <span class="ticket-card__more">{{ i18n.projects.read_more }}</span>
      </a>
      {% endfor %}
    </div>
  </div>
</section>

<!-- Blog highlights -->
<section class="section">
  <div class="container">
    <header class="section-head fade-in">
      <span class="section-head__index mono">[03]</span>
      <div class="section-head__text">
        <p class="section-head__label">{{ i18n.blog.highlights_label }}</p>
        <h2 class="section-head__title">{{ i18n.blog.highlights_title }}</h2>
      </div>
      <div class="section-head__rule" aria-hidden="true"></div>
    </header>
    <div class="blog-highlights__grid">
      {% set postsForLang = collections["posts_" + i18n.lang] | byView("leader") %}
      {% for post in postsForLang | limit(3) %}
      <a href="{{ post.url }}" class="blog-card fade-in">
        <span class="blog-card__topic">{{ i18n.topics[post.data.topic] }}</span>
        <h3 class="blog-card__title">{{ post.data.title }}</h3>
        <p class="blog-card__excerpt">{{ post.data.excerpt }}</p>
        <div class="blog-card__meta">
          <span>{{ post.data.date | dateWeek }}</span>
          <span class="blog-card__read">{{ i18n.blog.read_more }}</span>
        </div>
      </a>
      {% endfor %}
    </div>
    <div class="section__cta">
      <a href="/{{ i18n.lang }}/blog/" class="btn btn--ghost">{{ i18n.blog.cta_all if i18n.blog.cta_all else i18n.nav.blog }} →</a>
    </div>
  </div>
</section>
