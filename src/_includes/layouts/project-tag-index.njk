---
layout: layouts/base.njk
---

{#- Страница метки проектов вида «Лидер»: проекты текущего языка с этой
    меткой и то же облако меток, что в секции проектов на главной. `entry` —
    элемент коллекции projectTagPages_<lang>_leader (см. .eleventy.js). -#}
{% set tagPages = collections["projectTagPages_" + i18n.lang + "_leader"] %}
{% set currentTag = entry.tag %}

<div class="page-header">
  <div class="container container--narrow">
    <a href="/{{ i18n.lang }}/#projects" class="article__back">{{ i18n.projects.back }}</a>
    <h1 class="page-header__title">{{ i18n.leader.tags.project_title | replace("{tag}", entry.label) }}</h1>
    <p class="page-header__desc">{{ i18n.leader.tags.project_desc | replace("{tag}", entry.label) }}</p>
  </div>
</div>

<div class="blog-page">
  <div class="container">
    {% include "partials/tag-bar.njk" %}
    {% set projects = collections["projects_" + i18n.lang] | byView("leader") | byTag(entry.tag) %}
    {% include "partials/project-list.njk" %}
  </div>
</div>
