<!DOCTYPE html>
<html lang="{{ i18n.lang }}" dir="{{ i18n.dir }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  {# A post page is an article for social networks and search engines; every
      other page is a plain website (FR-62). -#}
  {%- set isArticle = kind == "posts" -%}
  {%- set pageTitle = (title + " — " + i18n.name) if title else (i18n.name + " — " + i18n.dev.hero.title) -%}
  {%- set metaDescription = description or excerpt or i18n.dev.hero.desc -%}
  {#- A post may bring its own cover; the site-wide image is the fallback. The
      1200×630 size is known for that fallback only, so a custom cover declares
      no size instead of a wrong one (FR-63). -#}
  {%- set metaImage = cover or "/assets/og-image.png" -%}
  {%- set metaImageAlt = title if cover else i18n.name + " — " + site.domain -%}
  {%- set localeNames = { ru: "ru_RU", en: "en_US", he: "he_IL" } -%}
  {%- set altRu = collections.all | altUrl(page.url, 'ru') -%}
  {%- set altEn = collections.all | altUrl(page.url, 'en') -%}
  {%- set altHe = collections.all | altUrl(page.url, 'he') -%}
  {%- set altLocales = { ru: altRu, en: altEn, he: altHe } -%}
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ metaDescription }}">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ metaDescription }}">
  <meta property="og:type" content="{{ 'article' if isArticle else 'website' }}">
  <meta property="og:url" content="https://{{ site.domain }}{{ page.url }}">
  <meta property="og:locale" content="{{ localeNames[i18n.lang] }}">
  {%- for lang, altUrlValue in altLocales %}{% if altUrlValue and lang != i18n.lang %}
  <meta property="og:locale:alternate" content="{{ localeNames[lang] }}">{% endif %}{% endfor %}
  <meta name="color-scheme" content="dark">
  <meta name="theme-color" content="#131519">
  <meta property="og:image" content="https://{{ site.domain }}{{ metaImage }}">
  {%- if not cover %}
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">{% endif %}
  <meta property="og:image:alt" content="{{ metaImageAlt }}">
  <meta name="twitter:card" content="summary_large_image">
  {%- if isArticle %}
  <meta property="article:published_time" content="{{ date | isoDateTime }}">
  <meta property="article:modified_time" content="{{ updated | default(date) | isoDateTime }}">
  {%- for tag in tags %}
  <meta property="article:tag" content="{{ i18n.tags.names[tag] }}">{% endfor %}
  {%- endif %}
  <link rel="canonical" href="https://{{ site.domain }}{{ page.url }}">
  {% if altRu %}<link rel="alternate" hreflang="ru" href="https://{{ site.domain }}{{ altRu }}">{% endif %}
  {% if altEn %}<link rel="alternate" hreflang="en" href="https://{{ site.domain }}{{ altEn }}">{% endif %}
  {% if altHe %}<link rel="alternate" hreflang="he" href="https://{{ site.domain }}{{ altHe }}">{% endif %}
  <link rel="alternate" hreflang="x-default" href="https://{{ site.domain }}{% if altEn %}{{ altEn }}{% else %}{{ page.url }}{% endif %}">
  <link rel="alternate" type="application/atom+xml" href="/{{ i18n.lang }}/dev/feed.xml" title="{{ i18n.name }} — {{ i18n.views.dev }}">
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='6' fill='%231a1b2e'/><text x='4' y='23' font-family='monospace' font-size='18' font-weight='bold' fill='%230ea5e9'>MZ</text></svg>">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/assets/dev.css">
  <script>document.documentElement.classList.add('js');</script>
</head>
<body>
  <a href="#main" class="skip-link">{{ i18n.skip_link }}</a>

  <header class="ide-titlebar">
    <div class="ide-titlebar__traffic" aria-hidden="true"><span></span><span></span><span></span></div>
    <span class="ide-titlebar__project">~/{{ site.domain }}</span>

    <div class="ide-titlebar__spacer"></div>

    <nav class="view-switch" aria-label="{{ i18n.views.aria_switch }}">
      <a href="{{ collections.all | switchViewUrl(page.url, i18n.lang, 'leader') }}" data-view="leader" title="{{ i18n.views.dev }} → {{ i18n.views.leader_full }}" aria-label="{{ i18n.views.aria_to_leader }}">{{ i18n.views.leader }}</a>
      <span class="view-switch__item active" aria-current="page">{{ i18n.views.dev }}</span>
    </nav>

    <div class="lang-switch">
      <a href="{{ collections.all | switchLangUrl(page.url, 'ru') }}" class="{% if i18n.lang == 'ru' %}active{% endif %}" hreflang="ru">RU</a>
      <a href="{{ collections.all | switchLangUrl(page.url, 'en') }}" class="{% if i18n.lang == 'en' %}active{% endif %}" hreflang="en">EN</a>
      <a href="{{ collections.all | switchLangUrl(page.url, 'he') }}" class="{% if i18n.lang == 'he' %}active{% endif %}" hreflang="he">HE</a>
    </div>

    <button class="menu-toggle" type="button" data-menu-toggle aria-controls="ide-sidebar" aria-expanded="false" aria-label="{{ i18n.a11y.menu_open }}" data-label-open="{{ i18n.a11y.menu_open }}" data-label-close="{{ i18n.a11y.menu_close }}">
      <svg class="icon-menu" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      <svg class="icon-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="5" y1="5" x2="19" y2="19"/><line x1="19" y1="5" x2="5" y2="19"/></svg>
    </button>
  </header>

  <div class="ide-shell">
    <nav class="ide-sidebar" id="ide-sidebar" data-menu-panel data-menu-open-class="ide-sidebar--open" aria-label="{{ i18n.a11y.navigation }}">
      <div class="tree">
        <a class="tree__item tree__item--file {% if page.url == '/' + i18n.lang + '/dev/' %}tree__item--active{% endif %}" href="/{{ i18n.lang }}/dev/">
          <span class="tree__icon tree__icon--readme" aria-hidden="true"></span>readme.md
        </a>
        <a class="tree__item tree__item--file" href="/{{ i18n.lang }}/dev/#about">
          <span class="tree__icon tree__icon--about" aria-hidden="true"></span>about.md
        </a>

        <a class="tree__item tree__item--folder" href="/{{ i18n.lang }}/dev/blog/">
          <span class="tree__icon tree__icon--folder" aria-hidden="true"></span>blog/
        </a>
        <ul class="tree__list">
          {% set devPosts = collections["posts_" + i18n.lang] | byView("dev") %}
          {% for post in devPosts %}
          <li>
            <a class="tree__item tree__item--file {% if page.url == post.url %}tree__item--active{% endif %}" {% if page.url == post.url %}aria-current="page"{% endif %} href="{{ post.url }}">
              <span class="tree__icon tree__icon--file" aria-hidden="true"></span>{{ post.data.slug }}.md
            </a>
          </li>
          {% endfor %}
        </ul>

        {% set devProjects = collections["projects_" + i18n.lang] | byView("dev") %}
        {% if devProjects | length > 0 %}
        <a class="tree__item tree__item--folder" href="/{{ i18n.lang }}/dev/#projects">
          <span class="tree__icon tree__icon--folder" aria-hidden="true"></span>projects/
        </a>
        <ul class="tree__list">
          {% for proj in devProjects %}
          <li>
            <a class="tree__item tree__item--file {% if page.url == proj.url %}tree__item--active{% endif %}" {% if page.url == proj.url %}aria-current="page"{% endif %} href="{{ proj.url }}">
              <span class="tree__icon tree__icon--file" aria-hidden="true"></span>{{ proj.data.slug }}/
            </a>
          </li>
          {% endfor %}
        </ul>
        {% endif %}
      </div>
    </nav>

    <div class="ide-main">
      <nav class="ide-tabs" aria-label="{{ i18n.a11y.navigation }}">
        {% set devHome = '/' + i18n.lang + '/dev/' %}
        {% set devBlog = devHome + 'blog/' %}
        {#- Тип страницы решает активную вкладку и хлебные крошки: проект —
            поле `order`, статья — `slug`, страница метки — alias `entry`
            пагинации, индекс блога — URL. -#}
        {% if order %}{% set kind = 'project' %}
        {% elif slug %}{% set kind = 'post' %}
        {% elif entry %}{% set kind = 'tag' %}
        {% elif page.url == devBlog %}{% set kind = 'blog' %}
        {% else %}{% set kind = 'readme' %}{% endif %}
        <a class="ide-tab {% if kind == 'readme' %}ide-tab--active{% endif %}" {% if kind == 'readme' %}aria-current="page"{% endif %} href="{{ devHome }}">readme.md</a>
        <a class="ide-tab {% if kind == 'blog' or kind == 'post' or kind == 'tag' %}ide-tab--active{% endif %}" {% if kind == 'blog' or kind == 'post' or kind == 'tag' %}aria-current="page"{% endif %} href="{{ devBlog }}">blog/</a>
        {% if kind == 'post' %}
        <span class="ide-tab ide-tab--active" aria-current="page">{{ slug }}.md</span>
        {% elif kind == 'project' %}
        <span class="ide-tab ide-tab--active" aria-current="page">{{ slug }}/</span>
        {% elif kind == 'tag' %}
        <span class="ide-tab ide-tab--active" aria-current="page">tags/{{ entry.tag }}/</span>
        {% endif %}
      </nav>

      <div class="ide-breadcrumbs">
        <span>~/{{ site.domain }}</span>
        {% if kind == 'blog' or kind == 'post' or kind == 'tag' %}
        <span class="ide-breadcrumbs__sep">›</span><span>blog/</span>
        {% elif kind == 'project' %}
        <span class="ide-breadcrumbs__sep">›</span><span>projects/</span>
        {% endif %}
        {% if kind == 'post' %}
        <span class="ide-breadcrumbs__sep">›</span><span>{{ slug }}.md</span>
        {% elif kind == 'project' %}
        <span class="ide-breadcrumbs__sep">›</span><span>{{ slug }}/</span>
        {% elif kind == 'tag' %}
        <span class="ide-breadcrumbs__sep">›</span><span>tags/{{ entry.tag }}/</span>
        {% endif %}
      </div>

      <main id="main" class="ide-editor">
        {{ content | safe }}
      </main>
    </div>
  </div>

  <footer class="ide-statusbar">
    <div class="ide-statusbar__group">
      <span class="ide-statusbar__item" aria-hidden="true">⎇ main</span>
      <span class="ide-statusbar__item" aria-hidden="true">UTF-8</span>
      <span class="ide-statusbar__item" aria-hidden="true">LF</span>
      <span class="ide-statusbar__item">{{ i18n.name }}</span>
    </div>
    <div class="ide-statusbar__group">
      <a class="ide-statusbar__item" href="{{ site.github }}" target="_blank" rel="noopener">GitHub</a>
      <a class="ide-statusbar__item" href="mailto:{{ site.email }}">{{ site.email }}</a>
      <span class="ide-statusbar__item">© {{ site.year }}</span>
    </div>
  </footer>

  <script src="/assets/app.js"></script>
</body>
</html>