---
pagination:
  data: redirects
  size: 1
  alias: r
permalink: "{{ r.from }}"
eleventyExcludeFromCollections: true
---
<!DOCTYPE html>
<html lang="{{ r.from | langFromPath }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow">
  <title>{{ r.to }}</title>
  <link rel="canonical" href="https://{{ site.domain }}{{ r.to }}">
  <meta http-equiv="refresh" content="0;url={{ r.to }}">
</head>
<body>
  <p><a href="{{ r.to }}">{{ r.to }}</a></p>
</body>
</html>